# Final public URL of this site (used for canonical links, sitemap, schema).
SITE_URL=https://rpverma.in

# Lead endpoint on the NRS Group website. Add this site's URL to
# LEAD_ALLOWED_ORIGINS on the NRS Group site. If empty, the partner form
# falls back to opening the visitor's email app.
PUBLIC_LEAD_ENDPOINT=https://YOUR-NRS-GROUP-SITE/api/leads

# Optional cross-link to the NRS Group corporate website.
PUBLIC_NRS_GROUP_URL=
