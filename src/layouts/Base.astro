---
import "../styles/global.css";
import Monogram from "../components/Monogram.astro";
import {
  companiesFounded,
  contact,
  nav,
  nrsGroupUrl,
  person,
  profiles,
  seo,
  ventureSectors,
} from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = seo.description, image = "/images/og-rp-verma.jpg" } = Astro.props;
const fullTitle = title ? `${title} | R. P. Verma, Founder & Chairman of NRS Group` : seo.title;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const path = Astro.url.pathname;

const websites = ventureSectors.flatMap((s) => s.ventures).filter((v) => v.url);
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": new URL("/#person", site).href,
  name: person.fullName,
  alternateName: person.alternateNames,
  jobTitle: "Chairman & Managing Director",
  description: seo.description,
  image: new URL(person.portrait, site).href,
  url: site.href,
  worksFor: { "@id": new URL("/#nrs-group", site).href },
  founder: companiesFounded.map((c) => ({ "@type": "Organization", name: c.name, foundingDate: String(c.year) })),
  workLocation: { "@type": "Place", name: "Kolkata, West Bengal, India" },
  sameAs: [...profiles.map((p) => p.href), ...(nrsGroupUrl ? [nrsGroupUrl] : [])],
};
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": new URL("/#nrs-group", site).href,
  name: "NRS Group",
  foundingDate: "2014",
  founder: { "@id": new URL("/#person", site).href },
  ...(nrsGroupUrl ? { url: nrsGroupUrl } : {}),
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.addressLines.slice(0, 2).join(", "),
    addressLocality: "Kolkata",
    postalCode: "700091",
    addressRegion: "West Bengal",
    addressCountry: "IN",
  },
  subOrganization: websites.map((w) => ({ "@type": "Organization", name: w.name, url: w.url })),
  sameAs: profiles.filter((p) => p.label.startsWith("NRS Group")).map((p) => p.href),
};
const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "R. P. Verma",
  url: site.href,
  about: { "@id": new URL("/#person", site).href },
};
const isActive = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={person.fullName} />
    <meta name="theme-color" content="#0F1B2D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="R. P. Verma" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta property="profile:first_name" content="Ravinandan Prasad" />
    <meta property="profile:last_name" content="Verma" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="header" data-header>
      <div class="container header__inner">
        <a href="/" class="wordmark" aria-label="R. P. Verma, home">
          <Monogram size={42} />
          <span class="wordmark__text">
            <strong>R. P. Verma</strong>
            <span>Founder · NRS Group</span>
          </span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
          <span class="sr-only">Menu</span>
          <span class="menu-btn__bars" aria-hidden="true"></span>
        </button>
        <nav id="site-nav" class="nav" aria-label="Main" data-nav>
          {
            nav.map((n) => (
              <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
          <a href="/partner/" class="btn btn--gold btn--sm nav__cta">Partner with us</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="jali-band" aria-hidden="true"></div>
      <div class="container footer__grid">
        <div class="footer__about">
          <a href="/" class="wordmark wordmark--footer">
            <Monogram size={52} />
            <span class="wordmark__text">
              <strong>R. P. Verma</strong>
              <span>{person.title}, NRS Group</span>
            </span>
          </a>
          <p>
            The official website of {person.fullName}, founder of NRS Group: hotels, restaurants, real estate and
            leisure across eastern India.
          </p>
          <p class="footer__quote">&ldquo;Quality services demand quality people.&rdquo;</p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/journey/">Journey</a></li>
            <li><a href="/vision/">Vision &amp; mission</a></li>
            <li><a href="/gallery/">Gallery</a></li>
            <li><a href="/insights/">Insights</a></li>
            <li><a href="/media/">Media</a></li>
          </ul>
        </div>
        <div>
          <h2>Ventures</h2>
          <ul>
            {websites.map((w) => (
              <li>
                <a href={w.url} target="_blank" rel="noopener">{w.name}</a>
              </li>
            ))}
            {nrsGroupUrl && (
              <li>
                <a href={nrsGroupUrl} target="_blank" rel="noopener">NRS Group</a>
              </li>
            )}
            <li><a href="/ventures/">All ventures</a></li>
          </ul>
        </div>
        <div>
          <h2>Contact</h2>
          <address>
            {contact.addressLines.map((l) => (
              <>
                {l}
                <br />
              </>
            ))}
          </address>
          <p>
            <a href={contact.phoneHref}>{contact.phone}</a>
            <br />
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
          <a href="/partner/" class="btn btn--outline-gold btn--sm">Partner with us</a>
        </div>
      </div>
      <div class="container footer__base">
        <span>© {new Date().getFullYear()} {person.fullName}. All rights reserved.</span>
        <span class="footer__profiles">
          {profiles.map((p) => (
            <a href={p.href} target="_blank" rel="noopener">{p.label.replace("NRS Group on ", "")}</a>
          ))}
        </span>
      </div>
    </footer>

    <nav class="mobile-bar" aria-label="Quick actions">
      <a href={contact.phoneHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
        Call
      </a>
      <a href={contact.whatsappHref} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.6-4.6A9 9 0 1 1 8 20.2L3 21z" /><path d="M9 9.5c.5 2.5 2.5 4.5 5 5l1.2-1.2 2 1-.6 1.6c-3.6.4-8.4-4.4-8-8l1.6-.6 1 2z" /></svg>
        WhatsApp
      </a>
      <a href="/partner/" class="mobile-bar__cta">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 12l3 3 5-6" /><circle cx="12" cy="12" r="9" /></svg>
        Partner with us
      </a>
    </nav>

    <script>
      // Mobile menu
      const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
      const navEl = document.querySelector<HTMLElement>("[data-nav]");
      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        navEl?.classList.toggle("is-open", !open);
        document.body.classList.toggle("menu-open", !open);
      });

      // Header shadow on scroll
      const header = document.querySelector("[data-header]");
      const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Fade-up reveal
      const reveal = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduced || !("IntersectionObserver" in window)) {
        reveal.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }),
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        reveal.forEach((el) => io.observe(el));
      }

      // Count-up numbers: <span data-count="13+">
      document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
        const raw = el.dataset.count!;
        const m = raw.match(/^([^\d]*)([\d,]+)(.*)$/);
        if (!m || reduced) return;
        const target = Number(m[2].replace(/,/g, ""));
        const fmt = (n: number) => `${m[1]}${n.toLocaleString("en-IN")}${m[3]}`;
        el.textContent = fmt(0);
        const io = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          const start = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - start) / 1400);
            el.textContent = fmt(Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
        io.observe(el);
      });

      // Timeline line draws itself as you scroll
      const tl = document.querySelector<HTMLElement>("[data-timeline]");
      if (tl && !reduced) {
        const update = () => {
          const r = tl.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (innerHeight * 0.7 - r.top) / r.height));
          tl.style.setProperty("--progress", String(p));
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
      } else if (tl) {
        tl.style.setProperty("--progress", "1");
      }
    </script>
  </body>
</html>
