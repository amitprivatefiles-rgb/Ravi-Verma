---
import { stats } from "../data/site";
interface Props {
  light?: boolean;
}
const { light } = Astro.props;
---

<section class:list={["stats", { "stats--light": light }]} aria-label="At a glance">
  <div class="container stats__grid">
    {
      stats().map((s) => (
        <div class="stat" data-reveal>
          <span class="stat__value" data-count={s.value}>
            {s.value}
          </span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))
    }
  </div>
</section>
