---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import Monogram from "../components/Monogram.astro";
import QuoteBand from "../components/QuoteBand.astro";
import SectionHead from "../components/SectionHead.astro";
import Stats from "../components/Stats.astro";
import { bio, currentProjects, home, person, quotes, timeline, upcoming, ventureSectors } from "../data/site";

const sectorTiles = [
  { title: "Hospitality", body: "NRS Royal Palace, Puri, and Verma Holiday Hotel & Resorts.", icon: "M3 21h18M5 21V9l7-5 7 5v12M9 21v-5h6v5" },
  { title: "Food & Dining", body: "Bistro Y, HakkaLand, Bistro-Y Foods and Buono Gusto Foods.", icon: "M7 3v8a2 2 0 0 0 2 2v8M5 3v5M9 3v5M17 21V3c-2 1.5-3 4-3 7s1 4 3 4" },
  { title: "Real Estate & Construction", body: "Realtiven Construction and Shaila Realty Management.", icon: "M4 21h16M8 21V4h12M8 4 4 7M16 4v5M14 9h4v3h-4z" },
  { title: "Leisure & Business", body: "Eco Amusement Dam Park and NRS Business Centre.", icon: "M12 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12zM9 21l3-5 3 5M7 21h10" },
];
const milestones = timeline.filter((t) => /^\d{4}$/.test(t.year));
const sectorCount = ventureSectors.length;
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="jali-overlay" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">{person.shortTitle}</p>
        <h1 class="hero__name">
          R. P. Verma
          <span class="hero__fullname">{person.fullName}</span>
        </h1>
        <p class="hero__headline">{home.headline}</p>
        <p class="lead">{home.subline}</p>
        <div class="btn-row">
          <a href="/journey/" class="btn btn--gold">Explore his journey</a>
          <a href="/partner/" class="btn btn--outline-light">Partner with NRS</a>
        </div>
      </div>
      <figure class="hero__portrait">
        <div class="hero__frame">
          <img src={person.portrait} alt={`${person.honorific}, ${person.shortTitle}`} width="900" height="1125" fetchpriority="high" />
        </div>
        <figcaption>
          <Monogram size={34} />
          <span>Founder of NRS Group · Kolkata</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <Stats />

  <!-- Intro -->
  <section class="section">
    <div class="container split">
      <div data-reveal>
        <p class="eyebrow">The founder</p>
        <h2>Quiet conviction, built one company at a time</h2>
      </div>
      <div data-reveal>
        <p class="lead">{home.intro}</p>
        <p class="muted">{bio[1]}</p>
        <a href="/about/" class="text-link">Read his story <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <QuoteBand quote={quotes.mantra} by="R. P. Verma · His life mantra" />

  <!-- Ventures preview -->
  <section class="section section--ivory">
    <div class="container">
      <SectionHead
        eyebrow="Ventures"
        title={`A group across ${sectorCount} sectors`}
        intro="From his first kitchen in 2013 to a palace hotel by the sea, every venture carries the same standard."
      />
      <div class="tiles">
        {
          sectorTiles.map((t) => (
            <a href="/ventures/" class="tile" data-reveal>
              <svg viewBox="0 0 24 24" aria-hidden="true" class="icon">
                <path d={t.icon} />
              </svg>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
              <span class="text-link">
                View ventures <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Flagship -->
  <section class="section">
    <div class="container feature" data-reveal>
      <img src={currentProjects[0].image} alt={currentProjects[0].imageAlt} class="feature__img" loading="lazy" />
      <div class="feature__body">
        <p class="eyebrow">The flagship · 2020</p>
        <h2>NRS Royal Palace, Puri</h2>
        <blockquote class="pull">&ldquo;{quotes.puri}&rdquo;</blockquote>
        <p class="muted">{bio[3]}</p>
        <div class="btn-row">
          <a href="/projects/" class="btn btn--ink">Current projects</a>
          <a href={currentProjects[0].url} class="text-link" target="_blank" rel="noopener">Visit nrsroyalpalace.com ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Journey preview -->
  <section class="section section--ink">
    <div class="jali-overlay" aria-hidden="true"></div>
    <div class="container">
      <SectionHead eyebrow="The journey" title="From 2012 to today" light />
      <ol class="mini-timeline" data-reveal>
        {
          milestones.map((m) => (
            <li>
              <span class="mini-timeline__year">{m.year}</span>
              <span>{m.title}</span>
            </li>
          ))
        }
      </ol>
      <p class="center">
        <a href="/journey/" class="btn btn--outline-light">See the full journey</a>
      </p>
    </div>
  </section>

  <!-- Upcoming spotlight -->
  <section class="section section--ivory">
    <div class="container spotlight" data-reveal>
      <div class="spotlight__art" aria-hidden="true">
        <svg viewBox="0 0 200 220" class="tower-art">
          <path d="M20 205h160" />
          <rect x="70" y="30" width="60" height="175" />
          {Array.from({ length: 13 }).map((_, i) => <path d={`M70 ${45 + i * 12}h60`} stroke-dasharray={i < 3 ? "3 4" : undefined} opacity={i < 3 ? 0.6 : 0.4} />)}
          <path d="M150 205V20M60 24h120M150 20l20 4M150 20l-20 4" />
        </svg>
        <span class="badge">{upcoming.featured.status}</span>
      </div>
      <div>
        <p class="eyebrow">Upcoming · Coming soon</p>
        <h2>{upcoming.featured.name}</h2>
        <p class="spotlight__place">{upcoming.featured.place}</p>
        <p class="lead">{upcoming.featured.body}</p>
        <dl class="facts">
          {upcoming.featured.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
        <div class="btn-row">
          <a href="/upcoming/" class="btn btn--ink">Upcoming projects</a>
          <a href="/partner/?type=Invest%20in%20a%20project" class="btn btn--outline-ink">Invest in Tarapith</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
